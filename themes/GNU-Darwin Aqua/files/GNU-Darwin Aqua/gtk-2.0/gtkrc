gtk-color-scheme = "bg_color:#EDEDED\nbase_color:#CFCFCF\nfg_color:#1C1C1C\ntext_color:#1C1C1C\nselected_bg_color:#2773BD\nselected_fg_color:#FFFFFF\ntooltip_bg_color:#CFCFCF\ntooltip_fg_color:#1C1C1C\nlink_color:#4E8FCE"

gtk-icon-sizes = "gtk-button=16,16"
style "gnu-darwin-aqua" {
 xthickness=2
 ythickness=2
 bg[NORMAL]=@bg_color
 bg[PRELIGHT]="#FFFFFF"
 bg[SELECTED]=@selected_bg_color
 bg[ACTIVE]="#FFFFFF"
 bg[INSENSITIVE]=@bg_color
 fg[NORMAL]=@fg_color
 fg[PRELIGHT]=@fg_color
 fg[SELECTED]=@selected_fg_color
 fg[ACTIVE]=@fg_color
 fg[INSENSITIVE]="#6B6B6B"
 text[NORMAL]=@text_color
 text[SELECTED]=@selected_fg_color
 text[INSENSITIVE]="#6B6B6B"
 base[NORMAL]=@base_color
 base[SELECTED]=@selected_bg_color
 base[INSENSITIVE]=@bg_color
 engine "murrine" {
  roundness=5
  contrast=1.0
  glazestyle=0
  glowstyle=0
  reliefstyle=0
  focus_color="#2773BD"
 }
}
class "*" style "gnu-darwin-aqua"
