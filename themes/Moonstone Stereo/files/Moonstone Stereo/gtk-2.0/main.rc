style "progressbar" {

  xthickness = 1
  ythickness = 1

  fg[NORMAL] = @fg_color
  fg[PRELIGHT] = @selected_fg_color

  engine "murrine" {
    rgba = FALSE
    roundness = 4
    contrast = 1.0
    glazestyle = 0
