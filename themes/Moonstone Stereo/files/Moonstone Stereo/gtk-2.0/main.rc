style "separator_menu_item" {

  GtkSeparatorMenuItem::horizontal-padding = 0
  GtkWidget::wide-separators = 1
  GtkWidget::separator-width = 1
  GtkWidget::separator-height = 7
    
  xthickness = 1
  ythickness = 1
    
  bg[NORMAL] = @menu_separator_color
    
  engine "murrine" 
  {
    rgba = FALSE
      separatorstyle = 0
  }
}

style "treeview_header" {
  ythickness = 1

  fg[PRELIGHT] = mix(0.70, @text_color, @base_color)
  font_name = "Bold"

  engine "murrine" {
    rgba = FALSE
    roundness = 4
    contrast = 1.0
    glazestyle = 0
    glowstyle = 0
    reliefstyle = 0
  }
}

# Treeview Rows

style "treeview" {

  xthickness = 2
  ythickness = 0

  base[NORMAL] = @base_color

  engine "murrine" {
    rgba = FALSE
    roundness = 4
    contrast = 1.0
    glazestyle = 0
    glowstyle = 0
    reliefstyle = 0
  }
}    

