style "combobox_separator" {

  xthickness = 0
  ythickness = 0
  GtkWidget::wide-separators = 1

}

style "combobox" {

  xthickness = 0
  ythickness = 0

}

style "combobox_button" {

  xthickness = 3
  ythickness = 3

}

style "range" {

  engine "murrine" {
    rgba = FALSE
    roundness = 4
    contrast = 1.0
    glazestyle = 0
